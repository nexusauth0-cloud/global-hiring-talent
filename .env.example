# Copy to .env and fill in real values. Never commit .env.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/global_hiring_talent"
# Separate DB for automated tests (tests are destructive on this DB only)
TEST_DATABASE_URL="postgresql://user:password@127.0.0.1:5432/global_hiring_talent_test"

# --- Application ---
# Base URL used in emails and absolute links (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Set to "production" in production
NODE_ENV="development"
# Secret used to sign/derive values (generate with: openssl rand -hex 32)
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Company identity (placeholders shown until confirmed) ---
COMPANY_NAME="Global Hiring Talent"
COMPANY_EMAIL="contact@example.com"
COMPANY_PHONE="+00 000 000 0000"
COMPANY_ADDRESS="Address to be confirmed"
COMPANY_DOMAIN="globalhiringtalent.com"
COMPANY_REGISTRATION="Registration details to be confirmed"

# --- Email delivery (pick a provider; outbox is used when neither is set) ---
# SMTP (e.g. Postmark, Brevo, Mailgun, SES SMTP). Preferred for real delivery.
SMTP_URL=""
SMTP_FROM="Global Hiring Talent <no-reply@example.com>"
# FormSubmit relay for the public contact form (requires one-time recipient
# verification email to be confirmed by the recipient address owner).
FORMSUBMIT_EMAIL=""
# Internal mailbox for recruitment notifications (new applications, hiring
# requests). Falls back to COMPANY_EMAIL when that is a real address.
RECRUITMENT_NOTIFY_EMAIL=""

# --- Email verification policy ---
# Leave "false" until an email provider above can deliver, otherwise existing
# unverified candidate/employer accounts would be locked out of their
# dashboards. Set to "true" to enforce verification for self-service accounts.
EMAIL_VERIFICATION_ENFORCED="false"

# --- Uploads ---
# CVs are stored as bytes in PostgreSQL (documents.data, bytea) so they persist
# on serverless hosts. UPLOAD_DIR is only read for legacy files created before
# the bytea migration; STORAGE_DRIVER is retained for backward compatibility.
STORAGE_DRIVER="local"
UPLOAD_DIR="var/uploads"
MAX_UPLOAD_BYTES="5242880"

# --- Bootstrap admin (used only by `npm run create-admin`) ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
